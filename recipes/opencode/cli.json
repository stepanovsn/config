{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": {
        "name": "system",
        "mode": "system"
    },
    "animations": true,
    "cursor": {
        "style": "block",
        "blinking": true
    },
    "mouse": false,
    "scroll": {
        "speed": 3,
        "acceleration": false
    },
    "prompt": {
        "editor": true,
        "paste": "compact",
        "image_preview": false
    },
    "session": {
        "sidebar": "hide",
        "scrollbar": false,
        "thinking": "show",
        "grouping": "auto",
        "image_preview": false,
        "tps": true,
        "markdown": "rendered",
        "new_location": "launch",
        "permissions": "prompt"
    },
    "tabs": {
        "mode": "on",
        "scope": "cwd",
        "layout": "vertical",
        "indicators": "numbers"
    },
    "diffs": {
        "source": "working",
        "wrap": "word",
        "tree": true,
        "single": false,
        "view": "split"
    },
    "attention": {
        "notifications": true,
        "sound": true,
        "volume": 0.4,
        "sound_pack": "opencode.default"
    },
    "terminal": {
        "title": true,
        "copy": "select"
    },
    "keybinds": {
        "leader": "ctrl+x",
        "app.exit": "<leader>q",
        "input.newline": false,
        "session.message.next": "ctrl+j",
        "session.message.previous": "ctrl+k",
        "session.user.message.next": "ctrl+alt+j",
        "session.user.message.previous": "ctrl+alt+k"
    },
    "leader": {
        "timeout": 2000
    }
}
